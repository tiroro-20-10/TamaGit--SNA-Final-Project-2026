# GitHub repo (owner/name) — one repo per team pet
GITHUB_REPO=owner/repository

# GitHub token — needed for: webhook auto-creation, initial stats, quest context, death notifications
GITHUB_TOKEN=ghp_...

# Webhook secret — generate: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# VPS URL used by tamagit status/live/sync (set locally by each developer)
TAMAGIT_VPS_URL=http://72.56.239.253:8000

# Optional daemon intervals (minutes)
TAMAGIT_SYNC_INTERVAL=10
TAMAGIT_SCAN_INTERVAL=30

# Optional: override state file location
TAMAGIT_STATE_PATH=~/.tamagit/state.json
